[Unit]
Description=AI Workbench web and authorized retrieval
After=network.target
[Service]
WorkingDirectory=/home/nanshan/workspace/services/ai-workbench/app
Environment=PYTHONPATH=/home/nanshan/workspace/services/ai-workbench/app/src
Environment=AIWORKBENCH_CONFIG=/home/nanshan/workspace/services/ai-workbench/config/settings.json
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=HF_HUB_OFFLINE=1
Environment=HF_HUB_DISABLE_TELEMETRY=1
ExecStart=/home/nanshan/workspace/projects/ai-workbench/.venv/bin/python -m uvicorn aiworkbench.app:app --factory --host 0.0.0.0 --port 8090 --no-access-log
Restart=on-failure
RestartSec=3
Slice=ai-workbench.slice
UMask=0077
[Install]
WantedBy=default.target
