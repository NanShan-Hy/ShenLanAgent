[Unit]
Description=TestDock execution queue and scheduler
After=network.target

[Service]
WorkingDirectory=/home/nanshan/workspace/services/autotest-platform/app
Environment=PYTHONPATH=/home/nanshan/workspace/services/autotest-platform/app/src
Environment=TESTDOCK_CONFIG=/home/nanshan/workspace/services/autotest-platform/config/settings.json
ExecStart=/home/nanshan/workspace/projects/autotest-platform/.venv/bin/python -m testdock.worker
Restart=on-failure
RestartSec=3
TimeoutStopSec=8
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
