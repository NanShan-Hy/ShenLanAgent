+package management
+
+import (
+    "time"
+    "github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+    "github.com/gin-gonic/gin"
+)
+
+// GetGatewayAccounts exposes selection identifiers and readiness only. It is
+// behind the existing loopback-only management authentication, never client keys.
+func (h *Handler) GetGatewayAccounts(c *gin.Context) {
+    accounts := make([]gin.H, 0)
+    if h.authManager == nil { c.JSON(503, gin.H{"error":"manager_unavailable"}); return }
+    now := time.Now()
+    model := c.Query("model")
+    for _, a := range h.authManager.List() {
+        if model != "" && !registry.GetGlobalRegistry().ClientSupportsModel(a.ID, model) { continue }
+        unavailable := a.Unavailable && a.NextRetryAfter.After(now)
+        blocked := a.Quota.Exceeded && a.Quota.NextRecoverAt.After(now)
+        if ms := a.ModelStates[model]; ms != nil {
+            unavailable = unavailable || (ms.Unavailable && ms.NextRetryAfter.After(now))
+            blocked = blocked || (ms.Quota.Exceeded && ms.Quota.NextRecoverAt.After(now))
+        }
+        accounts = append(accounts, gin.H{"id":a.ID,"provider":a.Provider,"disabled":a.Disabled,
+            "unavailable":unavailable,"quota_blocked":blocked,"requires_sign_in":a.RequiresSignIn})
+    }
+    c.JSON(200, gin.H{"accounts":accounts,"contract":1})
+}
