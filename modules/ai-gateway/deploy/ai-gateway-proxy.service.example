[Unit]
Description=AI Gateway HTTPS reverse proxy (configure domain and certificate first)
After=network-online.target ai-gateway.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/nanshan/workspace/services/ai-gateway
ExecStartPre=/home/nanshan/workspace/tools/nginx/1.24.0-2ubuntu7.19/usr/sbin/nginx -t -p /home/nanshan/workspace/services/ai-gateway/data/proxy/ -c /home/nanshan/workspace/services/ai-gateway/config/nginx.conf -e stderr
ExecStart=/home/nanshan/workspace/tools/nginx/1.24.0-2ubuntu7.19/usr/sbin/nginx -p /home/nanshan/workspace/services/ai-gateway/data/proxy/ -c /home/nanshan/workspace/services/ai-gateway/config/nginx.conf -e stderr
ExecReload=/home/nanshan/workspace/tools/nginx/1.24.0-2ubuntu7.19/usr/sbin/nginx -t -p /home/nanshan/workspace/services/ai-gateway/data/proxy/ -c /home/nanshan/workspace/services/ai-gateway/config/nginx.conf -e stderr
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGQUIT
TimeoutStopSec=15
Restart=on-failure
RestartSec=3
UMask=0077
MemoryMax=64M
Nice=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
