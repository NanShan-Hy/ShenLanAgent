# Include this file inside nginx's http block, or use the standalone renderer.
upstream @@UPSTREAM_NAME@@ {
    server 127.0.0.1:@@BACKEND_PORT@@;
    keepalive 16;
}

server {
    listen @@LISTEN_ADDRESS@@:@@TLS_PORT@@ ssl;
    server_name @@DOMAIN@@;
    if ($host != @@DOMAIN@@) { return 444; }

    ssl_certificate @@CERTIFICATE@@;
    ssl_certificate_key @@PRIVATE_KEY@@;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:@@UPSTREAM_NAME@@:1m;
    ssl_session_timeout 10m;

    client_max_body_size 4m;
    client_body_buffer_size 64k;
    client_body_timeout 30s;
    keepalive_timeout 65s;
    gzip off;

    # URLs can carry OAuth codes. Keep request logs and request-context errors off.
    access_log off;
    error_log /dev/null crit;

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header Connection "";
    # The application deliberately uses its connection peer for IP policies.
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-Proto "";
    proxy_set_header X-Real-IP "";
    proxy_connect_timeout 10s;
    proxy_read_timeout 310s;
    proxy_send_timeout 310s;
    send_timeout 310s;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_cache off;
    proxy_max_temp_file_size 0;
    proxy_next_upstream off;
    proxy_intercept_errors off;

    location / {
        proxy_pass http://@@UPSTREAM_NAME@@;
    }
}
