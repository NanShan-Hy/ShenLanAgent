[Unit]
Description=TestDock web and API
After=network.target

[Service]
WorkingDirectory=/home/nanshan/workspace/services/autotest-platform/app
Environment=PYTHONPATH=/home/nanshan/workspace/services/autotest-platform/app/src
Environment=TESTDOCK_CONFIG=/home/nanshan/workspace/services/autotest-platform/config/settings.json
ExecStart=/home/nanshan/workspace/projects/autotest-platform/.venv/bin/python -m uvicorn testdock.app:app --factory --host 0.0.0.0 --port 8088 --no-access-log
Restart=on-failure
RestartSec=3
UMask=0077
KillMode=control-group

[Install]
WantedBy=default.target
